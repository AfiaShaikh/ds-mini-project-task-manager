{
  "name": "distributed-task-management-system",
  "version": "1.0.0",
  "description": "Distributed Task Management System (RPC, Message Queues, SSE Streaming, P2P WebRTC, Fault Tolerance)",
  "main": "backend/server.js",
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "dev": "npm run start",
    "server": "node backend/server.js",
    "client": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build"
  },
  "keywords": [
    "distributed-systems",
    "rpc",
    "message-queue",
    "sse",
    "p2p",
    "fault-tolerance"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
